{
  "name": "munder-difflin",
  "version": "0.4.5",
  "private": true,
  "description": "あなたとチームの分身が24時間働く、無料・ローカルファーストのマルチエージェント基盤。普段使っているCLIコーディングエージェントが、PC上のエージェントチームをまとめます。",
  "main": "out/main/index.js",
  "author": "Chaitanya Giri",
  "homepage": "https://munderdiffl.in/",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaitanyagiri/munder-difflin.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "cd web && ../.task-tools/dioxus/bin/dx serve --web --fullstack true -p md-web-app --addr 127.0.0.1 --port 8080 --open false --cargo-args=--locked",
    "build": "electron-vite build && npm run copy:main-assets",
    "copy:main-assets": "node tools/copy-main-assets.cjs",
    "preview": "electron-vite preview",
    "postinstall": "node tools/ensure-pty-perms.cjs && node tools/patch-node-pty-conpty.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check:web": "cargo check --manifest-path web/Cargo.toml -p md-web-app --no-default-features --features server --locked && cargo check --manifest-path web/Cargo.toml -p md-web-app --no-default-features --features web --target wasm32-unknown-unknown --locked",
    "test:focused": "node --test test/*.test.cjs",
    "test:web": "cargo test --manifest-path web/Cargo.toml --workspace --locked",
    "check:links": "node tools/check-release-links.cjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "db:migrate": "node tools/db-migrate.cjs",
    "db:import": "node tools/db-import.cjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@openai/agents-realtime": "^0.11.8",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "commit-graph": "^2.4.0",
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.0.0",
    "pg": "^8.23.0",
    "pixi.js": "^8.5.1",
    "posthog-node": "^5.48.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tunnelmole": "^2.4.0",
    "ws": "^8.21.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "file:tools/npm/electron-builder-squirrel-windows",
    "electron-vite": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/asar": "4.3.0"
    },
    "@electron/get@3.1.0": {
      "global-agent": "4.1.3"
    },
    "electron-updater": {
      "lodash.isequal": "npm:fast-deep-equal@3.1.3"
    },
    "tunnelmole": {
      "multer": "2.2.0"
    }
  }
}
